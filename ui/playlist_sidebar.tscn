[node name="EnvScale" type="SpinBox" parent="Margin/Column/AssetTabs/Environments/EnvScaleRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 1.0
max_value = 20.0
step = 1.0
value = 1.0
allow_greater = true
allow_lesser = true
tooltip_text = "Per-environment scale after auto-fit (keeps path/framing updated)"

[node name="EnvHint" type="Label" parent="Margin/Column/AssetTabs/Environments"]
layout_mode = 2
autowrap_mode = 3
text = "Background / world. Click a row to apply. Play cycles with this timer. Scale keeps the flythrough readable."

