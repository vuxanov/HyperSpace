[gd_scene load_steps=2 format=3 uid="uid://playlist_sidebar"]

[ext_resource type="Script" path="res://ui/playlist_sidebar.gd" id="1"]

[node name="PlaylistSidebar" type="PanelContainer"]
custom_minimum_size = Vector2(360, 0)
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="VBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="ShowLabel" type="Label" parent="Margin/Column/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "HyperSpace"

[node name="ItemLabel" type="Label" parent="Margin/Column/Header"]
layout_mode = 2
text = "No item playing"

[node name="Transport" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="PrevButton" type="Button" parent="Margin/Column/Transport"]
layout_mode = 2
size_flags_horizontal = 3
text = "◀"

[node name="PlayButton" type="Button" parent="Margin/Column/Transport"]
layout_mode = 2
size_flags_horizontal = 3
text = "▶ Play"

[node name="NextButton" type="Button" parent="Margin/Column/Transport"]
layout_mode = 2
size_flags_horizontal = 3
text = "▶"

[node name="PresentButton" type="Button" parent="Margin/Column/Transport"]
layout_mode = 2
size_flags_horizontal = 3
text = "Present"

[node name="AutoplayRow" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="DefaultDurLabel" type="Label" parent="Margin/Column/AutoplayRow"]
layout_mode = 2
text = "Default sec"

[node name="DefaultDuration" type="SpinBox" parent="Margin/Column/AutoplayRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.5
max_value = 600.0
step = 0.5
value = 8.0
suffix = "s"

[node name="PlaylistTitle" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Playlist  (click name = replace · ▶ play · drag ⋮⋮ reorder)"

[node name="AddRow" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="AddMediaButton" type="Button" parent="Margin/Column/AddRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "+ Add Media"

[node name="AddEnvButton" type="MenuButton" parent="Margin/Column/AddRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "+ 3D Env ▾"

[node name="FlythroughSection" type="VBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="FlyTitle" type="Label" parent="Margin/Column/FlythroughSection"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Fly-through layers (swap independently)"

[node name="FlyHint" type="Label" parent="Margin/Column/FlythroughSection"]
layout_mode = 2
autowrap_mode = 3
text = "Background / scatter / main character — File or Test on each. Main stays centered on screen."

[node name="EnvLayerRow" type="HBoxContainer" parent="Margin/Column/FlythroughSection"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="EnvLabel" type="Label" parent="Margin/Column/FlythroughSection/EnvLayerRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Background"

[node name="EnvFileBtn" type="Button" parent="Margin/Column/FlythroughSection/EnvLayerRow"]
layout_mode = 2
text = "File"

[node name="EnvPrimBtn" type="MenuButton" parent="Margin/Column/FlythroughSection/EnvLayerRow"]
layout_mode = 2
text = "Test ▾"

[node name="ScatterLayerRow" type="HBoxContainer" parent="Margin/Column/FlythroughSection"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="ScatterLabel" type="Label" parent="Margin/Column/FlythroughSection/ScatterLayerRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Scatter"

[node name="ScatterFileBtn" type="Button" parent="Margin/Column/FlythroughSection/ScatterLayerRow"]
layout_mode = 2
text = "File"

[node name="ScatterPrimBtn" type="MenuButton" parent="Margin/Column/FlythroughSection/ScatterLayerRow"]
layout_mode = 2
text = "Test ▾"

[node name="CenterLayerRow" type="HBoxContainer" parent="Margin/Column/FlythroughSection"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="CenterLabel" type="Label" parent="Margin/Column/FlythroughSection/CenterLayerRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Main character"

[node name="CenterFileBtn" type="Button" parent="Margin/Column/FlythroughSection/CenterLayerRow"]
layout_mode = 2
text = "File"

[node name="CenterPrimBtn" type="MenuButton" parent="Margin/Column/FlythroughSection/CenterLayerRow"]
layout_mode = 2
text = "Test ▾"

[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="PlaylistList" type="VBoxContainer" parent="Margin/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="ClearButton" type="Button" parent="Margin/Column"]
layout_mode = 2
text = "Clear Playlist"

[node name="FileDialog" type="FileDialog" parent="."]
title = "Add Media"
size = Vector2i(900, 600)
access = 2
file_mode = 0
use_native_dialog = true
filters = PackedStringArray("*.gif,*.webm,*.mp4,*.ogv,*.png,*.jpg,*.jpeg,*.svg,*.webp,*.glb,*.gltf,*.tscn ; Media Files")

[node name="LayerFileDialog" type="FileDialog" parent="."]
title = "Choose layer model"
size = Vector2i(900, 600)
access = 2
file_mode = 0
use_native_dialog = true
filters = PackedStringArray("*.glb,*.gltf,*.tscn ; 3D Models")
