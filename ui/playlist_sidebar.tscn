[gd_scene load_steps=2 format=3 uid="uid://playlist_sidebar"]

[ext_resource type="Script" path="res://ui/playlist_sidebar.gd" id="1"]

[node name="PlaylistSidebar" type="PanelContainer"]
custom_minimum_size = Vector2(360, 0)
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Header" type="VBoxContainer" parent="Margin/Column"]
layout_mode = 2

[node name="ShowLabel" type="Label" parent="Margin/Column/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "HyperSpace"

[node name="StatusLabel" type="Label" parent="Margin/Column/Header"]
layout_mode = 2
autowrap_mode = 3
text = "Pick an asset to apply"

[node name="FlyRow" type="HBoxContainer" parent="Margin/Column/Header"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="FlyLabel" type="Label" parent="Margin/Column/Header/FlyRow"]
layout_mode = 2
text = "Fly speed"

[node name="FlySpeed" type="SpinBox" parent="Margin/Column/Header/FlyRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 1.0
max_value = 100.0
step = 1.0
value = 12.0
suffix = "u/s"
tooltip_text = "Camera fly-through speed along the path"

[node name="AssetTabs" type="TabContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3

[node name="Environments" type="VBoxContainer" parent="Margin/Column/AssetTabs"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="EnvControls" type="HBoxContainer" parent="Margin/Column/AssetTabs/Environments"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="EnvPlayBtn" type="Button" parent="Margin/Column/AssetTabs/Environments/EnvControls"]
layout_mode = 2
size_flags_horizontal = 3
text = "â–¶ Play"

[node name="EnvDurLabel" type="Label" parent="Margin/Column/AssetTabs/Environments/EnvControls"]
layout_mode = 2
text = "Sec"

[node name="EnvDuration" type="SpinBox" parent="Margin/Column/AssetTabs/Environments/EnvControls"]
layout_mode = 2
custom_minimum_size = Vector2(88, 0)
min_value = 1.0
max_value = 600.0
step = 1.0
value = 8.0
suffix = "s"

[node name="EnvScaleRow" type="HBoxContainer" parent="Margin/Column/AssetTabs/Environments"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="EnvScaleLabel" type="Label" parent="Margin/Column/AssetTabs/Environments/EnvScaleRow"]
layout_mode = 2
